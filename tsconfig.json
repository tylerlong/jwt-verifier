{
	"compilerOptions": {
		"allowUnreachableCode": false,
		"allowUnusedLabels": false,
		"declaration": true,
		"forceConsistentCasingInFileNames": true,
		"lib": ["es2018"],
		"module": "commonjs",
		"noEmitOnError": true,
		"noFallthroughCasesInSwitch": true,
		"noImplicitReturns": true,
		"outDir": "build",
		"pretty": true,
		"resolveJsonModule": true,
		"esModuleInterop": true,
		"sourceMap": true,
		"strict": true,
		"target": "es2018"
	},
	"include": ["src/**/*.ts"]
}
